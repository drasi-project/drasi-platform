FROM python:3.12-slim-bookworm AS build

COPY --from=ghcr.io/astral-sh/uv:0.11.27 /uv /usr/local/bin/uv

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /workspace/reactions/dapr/agent-router
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY --from=reaction_sdk pyproject.toml README.md /workspace/reactions/sdk/python/
COPY --from=reaction_sdk drasi /workspace/reactions/sdk/python/drasi
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --reinstall-package drasi-reaction-sdk

FROM python:3.12-slim-bookworm

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=build /app/.venv /app/.venv

USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["python", "-m", "uvicorn", "agent_router.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
