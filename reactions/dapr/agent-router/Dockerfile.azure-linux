FROM mcr.microsoft.com/azurelinux/base/python:3.12 AS build

COPY --from=ghcr.io/astral-sh/uv:0.11.27 /uv /usr/local/bin/uv

RUN tdnf install -y ca-certificates git && tdnf clean all

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

FROM mcr.microsoft.com/azurelinux/base/python:3.12

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=build /app/.venv /app/.venv

USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["python", "-m", "uvicorn", "agent_router.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
