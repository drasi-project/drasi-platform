{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ListQueriesResponse.json",
    "type": "object",
    "properties": {
        "protocol_version": {
            "type": "number",
            "const": 1
        },
        "delivery_schema_version": {
            "type": "number",
            "const": 1
        },
        "router_id": {
            "$ref": "RouterId.json"
        },
        "capabilities": {
            "type": "array",
            "items": {
                "$ref": "NonEmptyString.json"
            },
            "minItems": 1,
            "uniqueItems": true,
            "contains": {
                "const": "dynamic-subscriptions"
            }
        },
        "queries": {
            "type": "array",
            "items": {
                "$ref": "Query.json"
            }
        }
    },
    "required": [
        "protocol_version",
        "delivery_schema_version",
        "router_id",
        "capabilities",
        "queries"
    ],
    "title": "ListQueriesResponse"
}